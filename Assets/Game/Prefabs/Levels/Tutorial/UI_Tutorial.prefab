      m_Calls: []
  m_text: "<color=#EBDA80>Action Points (AP)</color> \u2013 how many major, time-consuming tasks you can complete in a day.\n<color=#8CC921>Will</color> \u2013 determines how willing you are to do things at all.\n<color=#86CCF8>Comfort</color> \u2013 affects your chances of successfully completing tasks.\n\nAt the beginning of each <color=#DDA0DD>new day</color>, all your stats reset.\nHowever, unfinished <color=#E68A8A>tasks</color> reduce your Comfort! Deal with them as soon as possible!"
  m_isRightToLeft: 0
